{
  "name": "ocaml-safetensors",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/thecbah/ocaml-features/ocaml:1": {
      "version": "${localEnv:OCAML_VERSION:4.14.3}",
      "packages": "bytesrw#${localEnv:BYTESRW_VERSION:0.2.0} dune#${localEnv:DUNE_VERSION:3.17.2} jsont#${localEnv:JSONT_VERSION:0.2.0} ocamlformat#0.29.0",
      "base-packages": ""
    }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ocamllabs.ocaml-platform"
      ]
    }
  },
  "runArgs": [
    "--cap-add=SYS_ADMIN"
  ]
}
